# Fase 2 — tekst-AI (Claude). Kopieer dit bestand naar .env.local en vul je eigen key in.
ANTHROPIC_API_KEY=
# Standaard Sonnet 5: foutloos Nederlands en sterke verhalen. Voor goedkoper/sneller
# testen kun je claude-haiku-4-5 gebruiken (wel meer taalfoutjes).
ANTHROPIC_MODEL=claude-sonnet-5

# Fase 4 — beeld-AI (fal.ai)
FAL_KEY=
# Harde daglimiet aan illustraties per kind (kostenrem). Default in code = 15 als deze
# ontbreekt. Op ~$0,07/plaatje (zie hieronder) is 100 goed voor een paar boeken per dag;
# verlaag dit als de kosten per kind te hard oplopen.
MAX_IMAGES_PER_DAY_PER_CHILD=100

# Beeldmodel omschakelbaar (kosten/snelheid). AANRADER en code-default: fal-ai/nano-banana-2
# (~$0,07/plaatje) — de echte scène-composer, gepositioneerd voor "hetzelfde personage over
# meerdere platen". De "lite"-familie (~$0,03/plaatje, sneller) is een schetsmachine voor
# grote volumes en houdt personages merkbaar mínder consistent vast; die stond hier eerder
# en gaf precies de klacht "mijn held verandert per hoofdstuk". Alleen kiezen als kosten
# echt zwaarder wegen dan consistentie — LET OP: lite zit bij fal.ai onder de "google/"-
# namespace, niet "fal-ai/" (fal-ai/nano-banana-lite bestaat niet en faalt altijd stil).
# IMAGE_EDIT_MODEL is het beeld-naar-beeld (referentie) model; laat het leeg
# (IMAGE_EDIT_MODEL=) om referentie-consistentie uit te zetten en terug te vallen op
# tekst-naar-plaatje.
IMAGE_MODEL=fal-ai/nano-banana-2
IMAGE_EDIT_MODEL=fal-ai/nano-banana-2/edit

# Supabase (live gaan). Project URL + service_role key uit Dashboard → Project Settings → API.
# Server-only; RLS staat aan. Niet committen — .env.local staat in .gitignore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
